{
  "name": "verifime-crap-gate",
  "version": "1.1.0",
  "private": true,
  "description": "CRAP ratchet gate for TypeScript repositories",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "crap-gate": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "crap:measure": "tsx src/cli.ts measure",
    "crap:check": "tsx src/cli.ts check",
    "crap:baseline": "tsx src/cli.ts baseline",
    "crap:diff": "tsx src/cli.ts diff"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
